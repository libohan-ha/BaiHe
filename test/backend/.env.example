DATABASE_URL="postgresql://postgres:your-password@localhost:5432/blog?schema=public"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
# In production this should be a random high-entropy secret (>= 32 chars).
JWT_SECRET_MIN_LENGTH=32
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=development
REQUEST_BODY_LIMIT=20mb
# Comma-separated CORS allowlist (full origins, no trailing slash)
# Example:
# CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.10:5173"
CORS_ORIGINS=""
# Auth rate limit (register/login)
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=20
